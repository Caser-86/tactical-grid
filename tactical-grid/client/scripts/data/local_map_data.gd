static func get_test_level() -> Dictionary:
	return {
		"id": "local_test_1",
		"name": "测试关卡",
		"mission_type": "extract",
		"size": {"width": 16, "height": 12},
		"seed": 12345,
		"layers": {
			"base_terrain": _make_base_terrain(16, 12),
			"blocker": _make_blockers(16, 12),
			"height_level": []
		},
		"spawns": {
			"player": [
				{"x": 1, "y": 9},
				{"x": 2, "y": 10},
				{"x": 1, "y": 10},
				{"x": 0, "y": 9},
			],
			"enemies": [
				{"x": 13, "y": 1, "job": "sentry_basic"},
				{"x": 14, "y": 2, "job": "sentry_basic"},
				{"x": 12, "y": 0, "job": "sentry_sniper"},
				{"x": 10, "y": 5, "job": "heavy_gunner"},
			]
		},
		"evac_point": {"x": 13, "y": 9},
		"scripts": []
	}

static func _make_base_terrain(width: int, height: int) -> Array:
	var grid = []
	for y in range(height):
		var row = []
		for x in range(width):
			# 添加一些地形变化：0 是默认地面，2 是轻度掩体/瓦片变化
			if (x + y) % 7 == 0:
				row.append(2)
			else:
				row.append(0)
		grid.append(row)
	return grid

static func _make_blockers(width: int, height: int) -> Array:
	var grid = []
	for y in range(height):
		var row = []
		for x in range(width):
			row.append(0)
		grid.append(row)
	# 放置一些掩体（6=半身掩体，7=全身掩体）
	var cover_positions = [
		Vector2i(4, 4), Vector2i(5, 4), Vector2i(4, 5), Vector2i(5, 5),
		Vector2i(9, 6), Vector2i(10, 6), Vector2i(9, 7), Vector2i(10, 7),
		Vector2i(7, 2), Vector2i(8, 2), Vector2i(7, 9), Vector2i(8, 9),
		Vector2i(12, 4), Vector2i(13, 7),
	]
	for pos in cover_positions:
		if pos.x >= 0 and pos.x < width and pos.y >= 0 and pos.y < height:
			grid[pos.y][pos.x] = 6
	# 少量全身掩体
	var full_cover_positions = [Vector2i(3, 7), Vector2i(11, 3), Vector2i(14, 8)]
	for pos in full_cover_positions:
		if pos.x >= 0 and pos.x < width and pos.y >= 0 and pos.y < height:
			grid[pos.y][pos.x] = 7
	return grid

