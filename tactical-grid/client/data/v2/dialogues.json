{
  "ch1_m1_brief": {
    "id": "ch1_m1_brief",
    "trigger": "mission_selected",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "commander", "text": "回声货场失去联系，侦察兵还在里面。", "emotion": "serious"},
      {"speaker": "alpha", "text": "单人进入，找到他就撤，不恋战。", "emotion": "neutral"},
      {"speaker": "commander", "text": "行动方针？", "emotion": "neutral", "choices": true}
    ],
    "choices": [
      {"text": "稳步推进", "flag": "ch1_m1_cautious", "response": {"speaker": "alpha", "text": "收到。先看清路线，再接近目标。", "emotion": "neutral"}},
      {"text": "快速接触", "flag": "ch1_m1_fast", "response": {"speaker": "alpha", "text": "明白。找到侦察兵就立刻撤离。", "emotion": "serious"}}
    ]
  },
  "ch1_m1_intro": {
    "id": "ch1_m1_intro",
    "trigger": "mission_start",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "commander", "text": "南侧入口安全。蓝色格子可移动，红色目标可攻击。", "emotion": "neutral"},
      {"speaker": "alpha", "text": "我会沿掩体推进。侦察兵的信标在中区。", "emotion": "serious"}
    ]
  },
  "ch1_m1_route": {
    "id": "ch1_m1_route",
    "trigger": "route_selected",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "commander", "text": "路线已定。别在分叉口久留，吊机是下一步。", "emotion": "serious"},
      {"speaker": "alpha", "text": "收到。沿标记推进，先打开中部通路。", "emotion": "neutral"}
    ]
  },
  "ch1_m1_gantry": {
    "id": "ch1_m1_gantry",
    "trigger": "gantry_lowered",
    "characters": [
      {"id": "commander", "position": "right"}
    ],
    "lines": [
      {"speaker": "commander", "text": "吊桥落下了。现在去中部侦察标记，靠近后执行营救。", "emotion": "serious"}
    ]
  },
  "ch1_m1_rescue": {
    "id": "ch1_m1_rescue",
    "trigger": "scout_rescued",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "alpha", "text": "找到你了。还能行动吗？", "emotion": "serious"},
      {"speaker": "commander", "text": "侦察兵归队。现在两人一起去东北撤离点。", "emotion": "neutral"}
    ]
  },
  "ch1_m1_intercept": {
    "id": "ch1_m1_intercept",
    "trigger": "evac_intercept_started",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "commander", "text": "撤离线被封锁，拦截哨兵已经出现。沿吊桥回撤，不要走东北直线。", "emotion": "serious"},
      {"speaker": "alpha", "text": "明白。两人保持在撤离标记内。", "emotion": "serious"}
    ]
  },
  "ch1_m1_record": {
    "id": "ch1_m1_record",
    "trigger": "optional_record_uploaded",
    "full_text": "事故记录显示，数据哨兵在撤离前已改写巡逻路线。侦察模块 B 已登记。",
    "characters": [
      {"id": "commander", "position": "right"}
    ],
    "lines": [
      {"speaker": "commander", "text": "记录上传完成。我们知道它在观察谁了。", "emotion": "serious"}
    ]
  },
  "ch1_m1_outro": {
    "id": "ch1_m1_outro",
    "trigger": "mission_victory",
    "characters": [
      {"id": "commander", "position": "right"},
      {"id": "alpha", "position": "left"}
    ],
    "lines": [
      {"speaker": "alpha", "text": "侦察兵安全，回声货场暂时安静了。", "emotion": "relieved"},
      {"speaker": "commander", "text": "带回的信号会指向下一处设施。先回基地整备。", "emotion": "serious"}
    ]
  },
  "ch1_m2_brief": {
    "id": "ch1_m2_brief",
    "trigger": "mission_selected",
    "characters": [{"id": "commander", "position": "right"}, {"id": "alpha", "position": "left"}],
    "lines": [
      {"speaker": "commander", "text": "冷却工坊失控，狙击手被困在东侧维护廊。", "emotion": "serious"},
      {"speaker": "alpha", "text": "先解除封锁，再接触目标。我们不需要清空整座工坊。", "emotion": "neutral"},
      {"speaker": "commander", "text": "控制室是可选目标。关闭喷口会让撤离更安全。", "emotion": "serious"}
    ]
  },
  "ch1_m2_intro": {
    "id": "ch1_m2_intro",
    "trigger": "mission_start",
    "characters": [{"id": "commander", "position": "right"}],
    "lines": [
      {"speaker": "commander", "text": "两条路都能解除封锁。跟紧目标标记，看到红色意图就先处理威胁。", "emotion": "neutral"}
    ]
  },
  "ch1_m2_route": {
    "id": "ch1_m2_route",
    "trigger": "lockdown_cleared",
    "characters": [{"id": "commander", "position": "right"}, {"id": "alpha", "position": "left"}],
    "lines": [
      {"speaker": "commander", "text": "封锁解除了。中央涡轮大厅有一条安全信号，先去那里确认目标位置。", "emotion": "serious"},
      {"speaker": "alpha", "text": "如果喷口开始预警，我们就绕开红色格，不要硬闯。", "emotion": "neutral"}
    ]
  },
  "ch1_m2_turbine": {
    "id": "ch1_m2_turbine",
    "trigger": "sniper_ability_showcase",
    "characters": [{"id": "commander", "position": "right"}, {"id": "scout", "position": "left"}],
    "lines": [
      {"speaker": "scout", "text": "狙击手已接入瞄准线。选择她，再点击红色目标即可标记威胁。", "emotion": "serious"},
      {"speaker": "commander", "text": "演示完成。现在只为撤离开路，不要在工坊里逗留。", "emotion": "neutral"}
    ]
  },
  "ch1_m2_cooling": {
    "id": "ch1_m2_cooling",
    "trigger": "cooling_nozzles_shutdown",
    "characters": [{"id": "commander", "position": "right"}],
    "lines": [
      {"speaker": "commander", "text": "喷口停了。少一个会逼我们停下来的东西，准备向北撤离。", "emotion": "relieved"}
    ]
  },
  "ch1_m2_rescue": {
    "id": "ch1_m2_rescue",
    "trigger": "sniper_rescued",
    "characters": [{"id": "commander", "position": "right"}, {"id": "sniper", "position": "left"}],
    "lines": [
      {"speaker": "sniper", "text": "我还能走。给我一个清晰目标，我就能替队伍打开缺口。", "emotion": "serious"},
      {"speaker": "commander", "text": "归队。接下来只做一件事：活着抵达北侧撤离门。", "emotion": "neutral"}
    ]
  },
  "ch1_m2_countermeasure": {
    "id": "ch1_m2_countermeasure",
    "trigger": "engineer_countermeasure_started",
    "characters": [{"id": "commander", "position": "right"}, {"id": "sniper", "position": "left"}],
    "lines": [
      {"speaker": "commander", "text": "工程师启动反制，北侧直线被封锁。改走东侧高架桥。", "emotion": "serious"},
      {"speaker": "sniper", "text": "收到。我会盯住高架桥尽头，别让他们切断撤离门。", "emotion": "serious"}
    ]
  },
  "ch1_m2_outro": {
    "id": "ch1_m2_outro",
    "trigger": "mission_victory",
    "characters": [{"id": "commander", "position": "right"}, {"id": "sniper", "position": "left"}],
    "lines": [
      {"speaker": "sniper", "text": "冷却工坊的信号还在。至少这次，他们没能把我们困在里面。", "emotion": "relieved"},
      {"speaker": "commander", "text": "回基地整备。下一次行动，狙击手由你选择是否出动。", "emotion": "neutral"}
    ]
  },
