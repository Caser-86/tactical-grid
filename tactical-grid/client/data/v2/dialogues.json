    "lines": [
      {"speaker": "commander", "text": "回声货场失去联系，侦察兵还在里面。", "emotion": "serious"},
      {"speaker": "alpha", "text": "单人进入，找到他就撤，不恋战。", "emotion": "neutral"},
      {"speaker": "commander", "text": "行动方针？", "emotion": "neutral", "choices": true}
    ],
    "choices": [
      {"text": "稳步推进", "flag": "ch1_m1_cautious", "response": {"speaker": "alpha", "text": "收到。先看清路线，再接近目标。", "emotion": "neutral"}},
      {"text": "快速接触", "flag": "ch1_m1_fast", "response": {"speaker": "alpha", "text": "明白。找到侦察兵就立刻撤离。", "emotion": "serious"}}
